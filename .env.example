# Copia este archivo como .env.local y completa los valores reales.
# En Vercel, agrega estas mismas variables en Project Settings > Environment Variables.

# Número de WhatsApp del negocio, formato internacional sin "+" (ej: 573143231456)
NEXT_PUBLIC_WHATSAPP_NUMBER=573143231456

# Supabase — Project Settings > API en tu proyecto de Supabase
NEXT_PUBLIC_SUPABASE_URL=https://TU-PROYECTO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=TU_ANON_KEY_PUBLICA

# Solo se usa en el servidor (API route de tracking), nunca se expone al navegador.
# Project Settings > API > service_role (secreto, NO lo pongas en NEXT_PUBLIC_*)
SUPABASE_SERVICE_ROLE_KEY=TU_SERVICE_ROLE_KEY

# URL pública del sitio (para metadata / sitemap)
NEXT_PUBLIC_SITE_URL=https://pintoresbogota.com
